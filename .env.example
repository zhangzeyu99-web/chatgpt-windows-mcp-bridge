# 示例环境变量（可提交）。复制到安装目录 .env 后按需修改。
# 密钥请放在 %APPDATA%\chatgpt-sol-local-bridge\ ，不要写进此文件的真实值。

HOST=127.0.0.1
PORT=8765
WORKSPACE_ROOTS=C:\Users\REPLACE\projects;C:\Users\REPLACE\Documents
DEFAULT_WORKSPACE=C:\Users\REPLACE\projects
ALLOW_TOOL_ROOT_REGISTRATION=false
INCLUDE_COMMON_WORKSPACE_ROOTS=false
DESTRUCTIVE_APPROVAL_MODE=chat
ALLOW_PRIVATE_NETWORK=false
TUNNEL_PROFILE=sol-local-bridge
TUNNEL_HEALTH_PORT=8766
# CONTROL_PLANE_TUNNEL_ID=tunnel_xxx   # 仅本机 runtime.env
# CONTROL_PLANE_API_KEY=sk-xxx        # 仅本机 runtime.env
